# ==========================================================
# TelegramMobileAgent Configuration
# Copy this file to .env and fill in your values
# ==========================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Your numeric Telegram User ID (obtain via @userinfobot)
# This restricts bot access exclusively to you.
TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id_here

# 3. Google Gemini API Key from Google AI Studio
# Get a free key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Desktop Workspace Directory (optional, defaults to ./workspace)
DEFAULT_WORKSPACE=./workspace

# 5. Default Gemini Model (optional, defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash (15 RPM), gemini-1.5-flash (15 RPM), gemini-2.5-pro (2 RPM), gemini-3.7-flash (5 RPM)
DEFAULT_MODEL=gemini-2.5-flash
