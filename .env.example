# ==========================================================
# TelegramMobileAgent Configuration
# Copy this file to .env and fill in your values
# ==========================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Your numeric Telegram User ID (obtain via @userinfobot)
# This restricts bot access exclusively to you.
TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id_here

# ----------------------------------------------------------
# AI Provider API Keys (Fill in at least ONE provider you use)
# ----------------------------------------------------------

# 1) Google Gemini (Free tier available at: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# 2) OpenAI (GPT-4o, o3-mini, o1: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# 3) Anthropic Claude (Claude 3.7 Sonnet, Claude 3.5: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4) DeepSeek (DeepSeek-V3, DeepSeek-R1: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 5) xAI Grok (optional: https://console.x.ai/)
XAI_API_KEY=your_xai_api_key_here

# ----------------------------------------------------------
# General Settings
# ----------------------------------------------------------

# Desktop Workspace Directory (optional, defaults to ./workspace)
DEFAULT_WORKSPACE=./workspace

# Default Model to launch with (can be switched anytime via /model in Telegram)
# Top Options:
# • Google: gemini-3.6-flash (15 RPM free), gemini-3.5-flash, gemini-2.5-pro, gemini-3.7-flash
# • OpenAI: gpt-4o, gpt-4o-mini, o3-mini, o1
# • Anthropic: claude-3-7-sonnet, claude-3-5-sonnet, claude-3-5-haiku
# • DeepSeek: deepseek-chat, deepseek-reasoner
# • xAI: grok-2-latest
DEFAULT_MODEL=gemini-3.6-flash

